{
  "manifest_version": 3,
  "name": "Scrawlix",
  "description": "Programmable censorship for the web.",
  "version": "0.0.0",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scrawlix"
  }
}
